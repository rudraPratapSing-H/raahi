# Gemini API Key for feature extraction using gemini-embedding-2
# Also used by /api/graph/node, /api/localize and as a fallback for /api/vision/find key rotation.
GEMINI_API_KEY=your_gemini_api_key_here

# Second Gemini key - powers /api/vision/detect (hazard detection) and is
# included in the /api/vision/find key-rotation pool.
GEMINI_API_KEY2=your_second_gemini_api_key_here

# Third Gemini key - powers /api/vision/score (hazard severity scoring) and is
# included in the /api/vision/find key-rotation pool.
GEMINI_API_KEY3=your_third_gemini_api_key_here

# MongoDB Atlas URI for uploading the topological graph
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
