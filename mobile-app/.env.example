# Gemini API key, called directly from the device (no backend to hold it
# server-side). EXPO_PUBLIC_ is required for Metro to inline it into the app
# bundle - see src/lib/gemini/geminiClient.ts for where it's read, and the
# plan's note on why this means the key is extractable from a built APK.
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
